# Copia este archivo como .env.local y llena los valores. Nunca subas valores reales al repo.
# En Vercel, las variables de Supabase las crea la integración de Supabase.

# --- Supabase (proyecto ynpvetdujkpxuaplsona) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor: rutas /api/usuarios, /api/portal*, webhook de WhatsApp.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: URL de redirección del correo de confirmación en desarrollo.
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=

# --- WhatsApp Cloud API (Meta) ---
# Token de acceso permanente de un usuario del sistema con permiso whatsapp_business_messaging.
WHATSAPP_TOKEN=
# Phone number ID (no es el número de teléfono) de WhatsApp Manager > API Setup.
WHATSAPP_PHONE_NUMBER_ID=
# Texto libre que inventas tú; el mismo se escribe como "Verify token" al registrar el webhook en Meta.
WHATSAPP_VERIFY_TOKEN=
# App secret de la app de Meta (App settings > Basic). Valida la firma X-Hub-Signature-256 del webhook.
WHATSAPP_APP_SECRET=
# Versión de la Graph API. Si se omite se usa v26.0.
WHATSAPP_API_VERSION=v26.0
